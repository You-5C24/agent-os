# 飞书自建应用凭证（第 3 篇 ao-03 手把手教你创建）
# Bot A（主力开发 bot）
BOT_A_APP_ID=cli_xxx
BOT_A_APP_SECRET=xxx

# Bot B（协作/审查 bot，第五章多机器人协作时才需要）
BOT_B_APP_ID=
BOT_B_APP_SECRET=

# 测试话题群 chat_id（把 bot 拉进群后获取）
TEST_CHAT_ID=oc_xxx

# 你自己的 open_id（跑通 echo bot 后从日志 sender= 字段获取，审批/通知篇会用）
OWNER_OPEN_ID=ou_xxx

# Claude Code 执行任务的项目目录，默认是 Agent OS 当前目录
CLAUDE_WORKDIR=

# Claude Code 的模型后端由 ~/.claude/settings.json 管理
# 没有 Anthropic 订阅时，可按课程指引接入 DeepSeek
